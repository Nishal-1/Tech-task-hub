{
  "name": "techtask-hub",
  "version": "1.0.0",
  "description": "TechTask Hub - Desktop App",
  "main": "electron.js",
  "scripts": {
    "start": "node server.js",
    "dev:backend": "node --watch server.js",
    "dev:frontend": "vite",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "electron": "electron .",
    "launch": "node launch.js",
    "dev:electron": "concurrently \"npm run dev\" \"npm run launch\"",
    "build": "vite build",
    "dist": "npm run build && electron-builder --win portable",
    "dist:dir": "npm run build && electron-builder --win dir"
  },
  "keywords": [
    "electron",
    "express",
    "sqlite",
    "react"
  ],
  "author": "Nishal",
  "license": "ISC",
  "build": {
    "appId": "com.nishal.techtaskhub",
    "productName": "TechTask Hub",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron.js",
      "preload.js",
      "server.js",
      "database.sqlite",
      "node_modules/**/*",
      "!node_modules/.cache/**/*",
      "!node_modules/.vite/**/*"
    ],
    "extraResources": [
      {
        "from": "server.js",
        "to": "server.js"
      },
      {
        "from": "database.sqlite",
        "to": "database.sqlite"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "TechTask-Hub-Portable-${version}.exe"
    },
    "publish": null
  },
  "dependencies": {
    "axios": "^1.15.0",
    "bootstrap": "^5.3.8",
    "cors": "^2.8.5",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.3",
    "express": "^4.21.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "vite": "^8.0.8",
    "wait-on": "^9.0.10"
  }
}
